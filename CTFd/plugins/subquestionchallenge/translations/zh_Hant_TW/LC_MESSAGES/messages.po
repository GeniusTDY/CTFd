# Admin create template - description block
msgid "Sub Question Challenges are a type of challenge that allows you to create a challenge with multiple questions and flags."
msgstr "多問題挑戰是一種允許您創建包含多個問題和 flag 的挑戰類型。"

msgid "Each question is worth a certain number of points, and the challenge is considered solved when all questions are answered correctly."
msgstr "每個問題都有對應的分值，當所有問題都回答正確後，該挑戰才算完成。"

msgid "You can also set a maximum number of attempts for each question."
msgstr "您還可以為每個問題設置最大嘗試次數。"

msgid "By HITCON ReCTF Team."
msgstr "由 HITCON ReCTF 團隊提供。"

# Admin create template - form fields
msgid "Connection Info"
msgstr "連接資訊"

msgid "Connection information (optional)"
msgstr "連接資訊（可選）"

msgid "Max Attempts"
msgstr "最大嘗試次數"

msgid "0 for unlimited"
msgstr "0 表示無限制"

msgid "Questions & Flags"
msgstr "問題與 Flag"

msgid "Question %(num)s"
msgstr "問題 %(num)s"

msgid "Enter question text"
msgstr "輸入問題描述"

msgid "Flag %(num)s"
msgstr "Flag %(num)s"

msgid "Enter flag"
msgstr "輸入 flag"

msgid "Points"
msgstr "分值"

msgid "Add Question"
msgstr "新增問題"

msgid "Remove Last Question"
msgstr "移除最後一個問題"

msgid "State"
msgstr "狀態"

msgid "Visible"
msgstr "可見"

msgid "Hidden"
msgstr "隱藏"

# Challenge type name
msgid "Sub Question Challenge"
msgstr "多問題挑戰"

# Admin create script - dynamic content
msgid "Please fill out the challenge name and category"
msgstr "請填寫挑戰名稱和類別"

msgid "Please fill out at least one question and its corresponding flag"
msgstr "請至少填寫一個問題和對應的 flag"

msgid "Failed to create challenge. Please check all fields are filled correctly."
msgstr "創建挑戰失敗，請檢查所有欄位是否正確填寫。"

msgid "An error occurred while creating the challenge"
msgstr "創建挑戰時發生錯誤"

# Challenge type display name (used in admin label and view interface)
msgid "Multi Question Challenge"
msgstr "多問題挑戰"

# View script - dynamic content
msgid "Score Acquired"
msgstr "已獲得分數"

msgid "Questions Completed"
msgstr "完成問題"

msgid "Questions Remaining"
msgstr "剩餘問題"

msgid "Question"
msgstr "問題"

msgid "points"
msgstr "分"

msgid "Completed"
msgstr "已完成"

msgid "Unsolved"
msgstr "待解決"

msgid "Select a question to answer:"
msgstr "選擇要回答的問題:"

msgid "Enter the flag for the selected question"
msgstr "輸入選定問題的 Flag"

msgid "Congratulations on completing all questions!"
msgstr "恭喜完成所有問題！"

msgid "You have successfully solved all questions in this multi-question challenge."
msgstr "您已成功解決了這個多問題挑戰的所有問題。"

msgid "Challenge Completed"
msgstr "挑戰完成"

msgid "All Completed"
msgstr "全部完成"

msgid "Hint"
msgstr "提示"

msgid "All questions have been completed! Congratulations on finishing this challenge."
msgstr "所有問題已完成！恭喜您完成了這個挑戰。"

msgid "Please select a question"
msgstr "請選擇一個問題"

msgid "Error"
msgstr "錯誤"

msgid "Please use the multi-question interface to submit"
msgstr "請使用多問題界面提交"

msgid "Wait"
msgstr "等待"

# Server-side attempt messages
msgid "Multi-question challenges must be submitted via the question selection interface"
msgstr "多問題挑戰必須使用問題選擇界面提交"

msgid "Invalid question number"
msgstr "無效的問題編號"

msgid "Question %(num)s does not exist"
msgstr "問題 %(num)s 不存在"

msgid "This question has no flag set"
msgstr "此問題未設定 flag"

msgid "Congratulations! You have completed all %(total)s questions!"
msgstr "恭喜！您已完成所有 %(total)s 個問題！"

msgid "Question %(num)s correct! %(solved)s/%(total)s questions completed"
msgstr "問題 %(num)s 正確！%(solved)s/%(total)s 個問題已完成"

msgid "Question %(num)s is incorrect"
msgstr "問題 %(num)s 不正確"
