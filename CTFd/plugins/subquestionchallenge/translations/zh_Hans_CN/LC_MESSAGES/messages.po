msgid "0 for unlimited"
msgstr "0 表示无限制"

msgid "Add Question"
msgstr "添加分题"

msgid "All Completed"
msgstr "全部完成"

msgid "All questions have been completed! Congratulations on finishing this challenge."
msgstr "所有分题已完成！恭喜您完成了这个题目。"

msgid "An error occurred while creating the challenge"
msgstr "创建题目时发生错误"

msgid "Awesome!"
msgstr "太棒了！"

msgid "By HITCON ReCTF Team."
msgstr "由 HITCON ReCTF 团队提供。"

msgid "Challenge Completed"
msgstr "题目完成"

msgid "Challenge Completed!"
msgstr "题目完成！"

msgid "Completed"
msgstr "已完成"

msgid "Congratulations on completing all questions!"
msgstr "恭喜完成所有分题！"

msgid "Congratulations, you have completed all questions! This multi-question challenge is now solved."
msgstr "恭喜您完成了所有分题！这个多单元题目已成功解决。"

msgid "Connection Info"
msgstr "连接信息"

msgid "Connection information (optional)"
msgstr "连接信息（可选）"

msgid "Each question is worth a certain number of points, and the challenge is considered solved when all questions are answered correctly."
msgstr "每个分题都有对应的分值，当所有分题均回答正确时，该题目即视为已完成。"

msgid "Enter flag"
msgstr "输入 flag"

msgid "Enter question text"
msgstr "输入分题描述"

msgid "Enter the flag for the selected question"
msgstr "输入选定分题的 Flag"

msgid "Error"
msgstr "错误"

msgid "Failed to create challenge. Please check all fields are filled correctly."
msgstr "创建题目失败，请检查所有字段是否正确填写。"

msgid "Flag %(num)s"
msgstr "Flag %(num)s"

msgid "Hidden"
msgstr "隐藏"

msgid "Hint"
msgstr "提示"

msgid "Max Attempts"
msgstr "最大尝试次数"

msgid "Multi Question Challenge"
msgstr "多单元"

msgid "Multi-question challenges must be submitted via the question selection interface"
msgstr "多单元题目必须使用分题选择界面提交"

msgid "OK"
msgstr "确定"

msgid "Please fill out at least one question and its corresponding flag"
msgstr "请至少填写一个分题和对应的 flag"

msgid "Please fill out the challenge name and category"
msgstr "请填写题目名称和类别"

msgid "Please select a question"
msgstr "请选择一个分题"

msgid "Please use the multi-question interface to submit"
msgstr "请使用多分题界面提交"

msgid "Points"
msgstr "分值"

msgid "Question"
msgstr "分题"

msgid "Question %(num)s"
msgstr "分题 %(num)s"

msgid "Questions & Flags"
msgstr "分题与 Flag"

msgid "Questions Completed"
msgstr "已完成分题"

msgid "Questions Remaining"
msgstr "剩余分题"

msgid "Remove Last Question"
msgstr "移除最后一个分题"

msgid "Score Acquired"
msgstr "已获得分数"

msgid "Select a question to answer:"
msgstr "选择要回答的分题："

msgid "State"
msgstr "状态"

msgid "Sub Question Challenge"
msgstr "多单元"

msgid "Sub Question Challenges are a type of challenge that allows you to create a challenge with multiple questions and flags."
msgstr "多单元题目是一种题目类型，允许您创建包含多个分题和多个 flag 的题目。"

msgid "Unsolved"
msgstr "未完成"

msgid "Visible"
msgstr "可见"

msgid "Wait"
msgstr "等待"

msgid "You can also set a maximum number of attempts for each question."
msgstr "您还可以为每个分题设置最大尝试次数。"

msgid "You have successfully solved all questions in this multi-question challenge."
msgstr "您已成功解决了这个多单元题目的所有分题。"

msgid "points"
msgstr "分"
